# Optional local-development overlay. This file is not loaded automatically.
# Copy it to `.env` (or export the variable explicitly) only for a private
# development/test instance. Never use it for a public or production server.
#
# This disables the production name-ownership boundary for scene deployments:
# any wallet with a valid auth chain may deploy under any world name, and that
# wallet is stored as the world owner.
IGNORE_NAME_OWNERSHIP_VALIDATION=true
